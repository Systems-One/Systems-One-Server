services:
  s1-monitor:
    build:
      context: .
      dockerfile: Dockerfile
    image: "{{ s1_monitor_image }}"
    container_name: s1_monitor
    restart: unless-stopped
    environment:
      DB_HOST: "{{ s1_monitor_db_host }}"
      DB_PORT: "{{ s1_monitor_db_port }}"
      DB_NAME: "{{ s1_monitor_db_name }}"
      DB_USER: "{{ s1_monitor_db_user }}"
      DB_PASS: "{{ s1_monitor_db_pass }}"
      TZ_OFFSET_HOURS: "{{ s1_monitor_tz_offset_hours }}"
      MIN_ITEMS_DAY: "{{ s1_monitor_min_items_day }}"
      MIN_ITEMS_HOUR: "{{ s1_monitor_min_items_hour }}"
      MIN_ITEMS_HALF_HOUR: "{{ s1_monitor_min_items_half_hour }}"
      OFFLINE_GAP_MINUTES: "{{ s1_monitor_offline_gap_minutes }}"
      STALE_DAYS: "{{ s1_monitor_stale_days }}"
      SNAPSHOT_ENABLED: "{{ 'true' if s1_monitor_snapshot_enabled else 'false' }}"
      SNAPSHOT_INTERVAL_MINUTES: "{{ s1_monitor_snapshot_interval_minutes }}"
      SNAPSHOT_RETENTION_DAYS: "{{ s1_monitor_snapshot_retention_days }}"
      CACHE_TTL_LIVE_SECONDS: "{{ s1_monitor_cache_ttl_live }}"
      CACHE_TTL_HISTORY_SECONDS: "{{ s1_monitor_cache_ttl_history }}"
      QUERY_TIMEOUT_SECONDS: "{{ s1_monitor_query_timeout }}"
    ports:
      - "{{ s1_monitor_bind_address }}:{{ s1_monitor_port }}:8000"
    healthcheck:
      test: ["CMD-SHELL", "python -c \"import urllib.request,sys; r=urllib.request.urlopen('http://localhost:8000/health',timeout=4); sys.exit(0 if r.status==200 else 1)\""]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 20s
    networks:
      - {{ docker_shared_network | default('infra') }}

networks:
  {{ docker_shared_network | default('infra') }}:
    external: true
